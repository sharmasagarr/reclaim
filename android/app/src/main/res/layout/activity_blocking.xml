<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/blocking_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="#0A0A0C">

    <LinearLayout
        android:id="@+id/blocking_content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tv_blocking_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️"
            android:textSize="54sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RECLAIM"
            android:textColor="#22C55E"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_blocking_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You're here to reclaim your time."
            android:textColor="#F8FAFC"
            android:textSize="23sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tv_blocking_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This content is blocked to protect your attention from infinite algorithmic scrolling. Normal features and search remain accessible."
            android:textColor="#94A3B8"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="36dp" />

        <Button
            android:id="@+id/btn_return_youtube"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Return to Normal App"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#22C55E"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_open_reclaim"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Open Reclaim"
            android:textAllCaps="false"
            android:textColor="#F8FAFC"
            android:textSize="15sp"
            android:backgroundTint="#18181B"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_take_breather"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="5-Minute Mindful Pass"
            android:textAllCaps="false"
            android:textColor="#71717A"
            android:textSize="13sp"
            style="?android:attr/borderlessButtonStyle" />

    </LinearLayout>
</ScrollView>
