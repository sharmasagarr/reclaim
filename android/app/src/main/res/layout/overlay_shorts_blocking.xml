<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0E">

    <!-- Subtle gradient decoration at top and bottom -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="top"
        android:background="#1E1E24" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingVertical="32dp">

            <!-- Reclaim Focus Pill Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_overlay_pill"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:letterSpacing="0.08"
                    android:text="RECLAIM FOCUS"
                    android:textColor="#22C55E"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Circular Shield / Focus Icon -->
            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_overlay_icon_circle">

                <TextView
                    android:id="@+id/tv_overlay_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="⏳"
                    android:textSize="36sp" />
            </FrameLayout>

            <!-- Main Title: Reclaim your time. -->
            <TextView
                android:id="@+id/tv_overlay_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:letterSpacing="-0.03"
                android:text="Reclaim your time."
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Description: Shorts are blocked during your focus session. -->
            <TextView
                android:id="@+id/tv_overlay_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="Shorts are blocked during your focus session. Regular YouTube videos, search, and subscriptions remain fully accessible."
                android:textColor="#A1A1AA"
                android:textSize="14sp" />

            <!-- Mindful Notice Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:background="@drawable/bg_overlay_notice_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:text="Use YouTube's bottom navigation below to switch to Home, Subscriptions, or You at any time."
                    android:textColor="#D4D4D8"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Primary Action: Return to Productive Viewing -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_return_productive"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_overlay_btn_primary"
                android:elevation="0dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="Return to Productive Viewing"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Secondary Action: 5-minute Breather -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_take_breather"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@null"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="Take a 5-minute breather ›"
                android:textAllCaps="false"
                android:textColor="#71717A"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
